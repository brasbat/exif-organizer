<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="app-root" xmlns:fx="http://javafx.com/fxml" fx:controller="org.brasbat.exiforganizer.HelloController">
    <top>
        <VBox spacing="6" styleClass="header">
            <padding><Insets top="16" right="18" bottom="12" left="18"/></padding>
            <Label text="EXIF Organizer" styleClass="title"/>
            <Label text="Configure the source, destination, and EXIF-based folder structure. The preview updates as you edit the configuration." styleClass="subtitle" wrapText="true"/>
        </VBox>
    </top>
    <center>
        <SplitPane styleClass="content-split" dividerPositions="0.38">
            <ScrollPane fitToWidth="true" minWidth="380" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox spacing="12" styleClass="settings-panel">
                        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                        <Label text="Organization settings" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                        <VBox spacing="8" styleClass="settings-section">
                            <Label text="Source" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <ListView fx:id="sourceFoldersView"
                                      minHeight="84" prefHeight="84" maxHeight="84"
                                      fixedCellSize="28" />
                            <HBox spacing="8">
                                <Button text="Add folder..." styleClass="secondary-button" onAction="#chooseSource" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button text="Remove selected" styleClass="secondary-button" onAction="#removeSource" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                            <CheckBox fx:id="includeSubfoldersCheckBox" text="Include subfolders" selected="true" onAction="#sourceOptionsChanged"/>
                        </VBox>
                        <VBox spacing="8" styleClass="settings-section">
                            <Label text="Target" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <HBox spacing="8">
                                <TextField fx:id="destinationField" promptText="Folder to organize into" HBox.hgrow="ALWAYS"/>
                                <Button text="Browse..." styleClass="secondary-button" onAction="#chooseDestination"/>
                            </HBox>
                            <CheckBox fx:id="moveCheckBox" text="Move files instead of copying"/>
                        </VBox>
                        <Separator/>
                        <VBox spacing="8" styleClass="settings-section">
                            <Label text="Folder structure" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <Label text="Each level becomes one folder. Select the EXIF property used for that level." styleClass="hint" wrapText="true"/>
                            <VBox fx:id="folderStructureEditor" spacing="6"/>
                            <Label text="Available properties include date parts, camera make, model, and all other available exif properties." styleClass="hint" wrapText="true"/>
                        </VBox>
                        <Separator/>
                        <VBox spacing="8" styleClass="settings-section">
                            <Label text="Image formats to organize" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <Label text="Select which discovered image formats should be organized." styleClass="hint" wrapText="true"/>
                            <VBox fx:id="imageFormatSelection" spacing="4"/>
                        </VBox>
                        <Separator/>
                        <Button fx:id="scanButton" text="Rescan source" styleClass="accent" onAction="#scan" maxWidth="Infinity"/>
                        <Button fx:id="organizeButton" text="Organize files" styleClass="danger" onAction="#organize" maxWidth="Infinity"/>
                    </VBox>
                </content>
            </ScrollPane>
            <VBox spacing="8" styleClass="preview-panel">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                <Label text="New structure preview" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label text="Folders and original filenames are shown using the current EXIF template." styleClass="hint" wrapText="true"/>
                <TreeView fx:id="previewTree" VBox.vgrow="ALWAYS"/>
                <Separator/>
                <Label text="EXIF statistics" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <ListView fx:id="statisticsView" prefHeight="190" fixedCellSize="26"/>
            </VBox>
        </SplitPane>
    </center>
    <bottom>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="status-bar">
            <padding><Insets top="10" right="18" bottom="10" left="18"/></padding>
            <ProgressBar fx:id="progressBar" prefWidth="180"/>
            <Label fx:id="statusLabel" styleClass="status-label" text="Choose source folder(s) to begin."/>
        </HBox>
    </bottom>
</BorderPane>
